---
import { Image } from "astro:assets";

import type { AstroSeoProps } from "@astrolib/seo";
import Comments from "@components/blog/Comments.astro";
import Title from "@components/global/Title.astro";
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import { Icon } from "astro-icon/components";
import BaseLayout from "./BaseLayout.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

type Props = {
	frontmatter: any;
	body: string;
	seo?: AstroSeoProps;
	structuredData?: Record<string, unknown>;
};

const { frontmatter, body, seo, structuredData } = Astro.props;

function getArticleReadingTime(body: string): number {
	if (!body) return 0;
	const wordsPerMinute = 183;
	const prose = body
		.replace(/```[\s\S]*?```/g, " ") // fenced code blocks
		.replace(/`[^`]*`/g, " ") // inline code
		.replace(/!?\[([^\]]*)\]\([^)]*\)/g, "$1") // links/images -> visible text
		.replace(/<[^>]+>/g, " ") // html tags
		.replace(/^\s*\|.*$/gm, " ") // table rows
		.replace(/[#>*_~`|-]/g, " "); // leftover markdown punctuation
	const numberOfWords = prose.split(/\s+/).filter(Boolean).length;
	const minutes = numberOfWords / wordsPerMinute;
	const readTime = Math.ceil(minutes);
	return readTime;
}

const readingTime = getArticleReadingTime(body);
const isBlogPost = Array.isArray(frontmatter.tags);
const publishedDate = frontmatter.pubDate instanceof Date ? frontmatter.pubDate.toISOString().slice(0, 10) : frontmatter.pubDate.toString().slice(0, 10);
---

<BaseLayout seo={seo} structuredData={structuredData} bodyClass={isBlogPost ? "blog-dark-page" : undefined}>
	{
		isBlogPost ? (
			<section class="blog-post">
				<article class="blog-post-shell mx-auto px-8 py-16 md:px-12 lg:py-28">
					<header class="blog-post-header pt-16">
						<h1 class="blog-post-title font-mono text-3xl font-semibold leading-tight text-slate-100 md:text-4xl">
							{frontmatter.title}
						</h1>
						<div class="blog-post-meta mt-5 flex flex-wrap gap-x-3 gap-y-1 font-mono text-sm text-slate-500">
							<time datetime={publishedDate}>{publishedDate}</time>
							<span aria-hidden="true">/</span>
							<a href={frontmatter.author.link} rel="author">
								{frontmatter.author.name}
							</a>
							<span aria-hidden="true">/</span>
							<span>~{readingTime} min</span>
						</div>
						<p class="blog-post-description mt-8 text-base leading-7 text-slate-400">
							{frontmatter.description}
						</p>
						{frontmatter?.link && (
							<a class="blog-post-project-link mt-6 inline-block font-mono text-sm font-bold" href={frontmatter?.link} target="_blank">
								<Icon name="iconamoon:link-external-thin" class="inline" /> {t("blog.gotoproject")}
							</a>
						)}
						{frontmatter?.tags?.length > 0 && (
							<ul class="blog-post-tags mt-8 flex flex-wrap gap-x-3 gap-y-2 font-mono text-xs uppercase text-slate-500">
								{frontmatter.tags.map((tag: string) => (
									<li>
										<a href={`/tags/${tag}`}>{tag}</a>
									</li>
								))}
							</ul>
						)}
						{frontmatter.image && (
							<Image
								class="blog-post-hero-image mt-10 w-full object-cover"
								src={frontmatter.image.source}
								alt={frontmatter.image.alt}
							/>
						)}
					</header>

					<div class="blog-post-prose prose-styles mt-12">
						<slot />
					</div>
					<Comments />
				</article>
			</section>
		) : (
			<section>
				<div class="mx-auto max-w-7xl px-8 py-12 md:px-12 lg:px-32 lg:py-32">
					<div class="flex flex-col gap-6 pt-20">
						{!frontmatter.image && !frontmatter.displayText && (
							<Title
								title={frontmatter.title}
								subtitle={`Written by: <a href="${frontmatter.author.link}" rel="author">${frontmatter.author.name}</a> on ${publishedDate}`}
							/>
						)}

						<p class="max-w-2xl text-base text-slate-500">
							<em>{frontmatter.description}</em>
						</p>

						{frontmatter?.link && (
							<a class="font-mono text-xl font-bold" href={frontmatter?.link} target="_blank">
								<Icon name="iconamoon:link-external-thin" class="inline" /> {t("blog.gotoproject")}
							</a>
						)}
					</div>
					<div class="mt-12 w-full justify-center">
						{frontmatter.image && frontmatter.transparentBg && (
							<div class="mt-12 flex h-96 w-full items-center justify-center rounded-lg">
								<Image class="max-h-full max-w-full object-contain" src={frontmatter.image.source} alt={frontmatter.image.alt} />
							</div>
						)}
						{frontmatter.image && !frontmatter.transparentBg && (
							<Image class="mt-12 w-full rounded-lg object-cover" src={frontmatter.image.source} alt={frontmatter.image.alt} />
						)}
						{!frontmatter.image && frontmatter.displayText && (
							<div class="mt-12 flex h-96 w-full items-center justify-center rounded-lg bg-zinc-900">
								<span class="font-display text-6xl font-bold uppercase tracking-wider text-white md:text-8xl">
									{frontmatter.displayText}
								</span>
							</div>
						)}

						<div class="prose-styles mt-12">
							<slot />
						</div>
					</div>
					<Comments />
				</div>
			</section>
		)
	}
</BaseLayout>
