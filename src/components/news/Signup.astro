---
import { getLangFromUrl, useTranslations } from "@i18n/utils";
import { getListThreads, LIST_ARCHIVE, LIST_NAME, LIST_OWNER } from "@lib/sourcehut";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// sourcehut list: ~ox0v1/BARGHEST@lists.sr.ht (plain-text email only)
const list = `~${LIST_OWNER}/${LIST_NAME}`;
const listAddress = `${list}@lists.sr.ht`;
const subscribe = `${list}+subscribe@lists.sr.ht`;
const unsubscribe = `${list}+unsubscribe@lists.sr.ht`;
const plaintextGuide = "https://useplaintext.email/";

const threads = await getListThreads();
const formatDate = (date: Date) => date.toISOString().slice(0, 10);

const sections = [
	{ heading: t("news.subscribe"), body: t("news.subscribe.body"), value: subscribe, href: `mailto:${subscribe}`, after: t("news.subscribe.after") },
	{
		heading: t("news.spam"),
		body: t("news.spam.body"),
		steps: [
			{ text: t("news.spam.step1"), value: listAddress },
			{ text: t("news.spam.step2") },
			{ text: t("news.spam.step3") },
		],
	},
	{ heading: t("news.unsubscribe"), body: t("news.unsubscribe.body"), value: unsubscribe, href: `mailto:${unsubscribe}` },
	{ heading: t("news.archive"), body: t("news.archive.body"), value: LIST_ARCHIVE, href: LIST_ARCHIVE },
	{ heading: t("news.plaintext"), body: t("news.plaintext.body"), value: plaintextGuide, href: plaintextGuide },
];
---

<section class="blog-index">
	<div class="mx-auto flex flex-col gap-16 px-8 py-24 md:px-12 lg:pt-32 2xl:max-w-7xl">
		<div class="blog-kicker pt-20">
			<p class="font-mono text-xs font-semibold uppercase text-slate-400">{t("news.kicker")}</p>
		</div>

		<div class="max-w-3xl font-mono text-base leading-7 text-slate-300">
			<h2 class="uppercase text-slate-100">{t("news.recent")}</h2>
			{
				threads.length ? (
					<>
					<p class="mt-2 pl-8 text-slate-400">
						{t("news.recent.note")} <span class="break-all text-slate-100">{LIST_ARCHIVE.replace("https://", "")}</span>
					</p>
					<ul class="mt-4 pl-8">
						{threads.map((thread) => (
							<li class="py-2">
								<a href={thread.url} class="group flex flex-col gap-x-6 sm:flex-row">
									<time class="shrink-0 text-slate-500" datetime={thread.date.toISOString()}>
										{formatDate(thread.date)}
									</time>
									<span>
										<span class="text-slate-100 underline underline-offset-4 group-hover:text-white">{thread.subject}</span>
										<span class="text-slate-500">
											{" "}
											{thread.from && `· ${thread.from}`}
											{thread.replies > 0 && ` · ${thread.replies} ${t("news.replies")}`}
										</span>
									</span>
								</a>
							</li>
						))}
					</ul>
					</>
				) : (
					<p class="mt-2 pl-8 text-slate-400">
						{t("news.recent.empty")}{" "}
						<a href={LIST_ARCHIVE} class="break-all text-slate-100 underline underline-offset-4 hover:text-white">
							{LIST_ARCHIVE}
						</a>
					</p>
				)
			}
		</div>

		<dl class="max-w-3xl font-mono text-base leading-7 text-slate-300">
			{
				sections.map((s) => (
					<div class="mb-10">
						<dt class="uppercase text-slate-100">{s.heading}</dt>
						<dd class="mt-2 pl-8">
							<p class="text-slate-400">{s.body}</p>
							{s.value && (
								<p class="my-3 pl-8">
									<a href={s.href} class="break-all text-slate-100 underline underline-offset-4 hover:text-white">
										{s.value}
									</a>
								</p>
							)}
							{s.steps && (
								<ol class="mt-3 list-decimal space-y-3 pl-8 text-slate-400">
									{s.steps.map((step) => (
										<li>
											{step.text}
											{step.value && <p class="my-2 break-all text-slate-100">{step.value}</p>}
										</li>
									))}
								</ol>
							)}
							{s.after && <p class="text-slate-400">{s.after}</p>}
						</dd>
					</div>
				))
			}
		</dl>
	</div>
</section>
