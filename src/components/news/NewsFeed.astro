---
import { getCollection } from "astro:content";
import { getLangFromUrl, useTranslatedPath, useTranslations } from "@i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const posts = (await getCollection("news"))
	.filter((entry) => entry.slug.split("/")[0] === "en")
	.map((entry) => ({ ...entry, slug: entry.slug.split("/").slice(1).join("/") }))
	.sort((a, b) => Number(b.data.pubDate) - Number(a.data.pubDate));
const dateLocale = lang === "cn" ? "zh-CN" : lang === "ru" ? "ru-RU" : "en-GB";
---

<section class="blog-index">
	<div class="mx-auto flex flex-col gap-16 px-8 py-24 md:px-12 lg:pt-32 2xl:max-w-7xl">
		<div class="blog-kicker pt-20">
			<p class="font-mono text-xs font-semibold uppercase text-slate-400">{t("feed.subtitle")}</p>
		</div>
		{
			posts.length ? (
				<ul class="blog-list">
					{posts.map((post) => (
						<li>
							<a href={translatePath(`/blog/${post.slug}/`)} class="group grid gap-2 py-8 md:grid-cols-12 md:gap-8">
								<time class="font-mono text-xs uppercase text-slate-500 md:col-span-3 md:pt-1.5" datetime={post.data.pubDate.toISOString()}>
									{post.data.pubDate.toLocaleDateString(dateLocale, { day: "numeric", month: "long", year: "numeric" })}
								</time>
								<div class="md:col-span-9">
									<p class="font-mono text-lg font-medium uppercase tracking-wide text-slate-100 transition-colors group-hover:text-white lg:text-xl">
										{post.data.title}
									</p>
									{post.data.description && <p class="mt-2 line-clamp-2 text-base text-slate-400">{post.data.description}</p>}
									{!!post.data.authors?.length && (
										<p class="mt-3 font-mono text-xs uppercase text-slate-500">{post.data.authors.map((author) => author.name).join(", ")}</p>
									)}
								</div>
							</a>
						</li>
					))}
				</ul>
			) : (
				<p class="text-lg text-slate-500">{t("feed.empty")}</p>
			)
		}
	</div>
</section>
