---
import { getCollection } from "astro:content";
import KickerPage from "@components/global/KickerPage.astro";
import { getLangFromUrl, useTranslatedPath } from "@i18n/utils";

const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);
const title = lang === "cn" ? "作者" : lang === "ru" ? "Авторы" : "Authors";
const subtitle =
	lang === "cn"
		? "了解参与 BARGHEST 研究和工具开发的团队。"
		: lang === "ru"
			? "Команда, работающая над исследованиями и инструментами BARGHEST."
			: "People behind BARGHEST research and tools.";

const allAuthors = (await getCollection("authors"))
	.filter((author) => {
		const [authorLang, ...slug] = author.slug.split("/");
		return authorLang === lang;
	})
	.map((author) => {
		const [authorLang, slug] = author.slug.split("/");

		return {
			...author,
			slug: slug,
		};
	});
---

<KickerPage label={title} note={subtitle}>
	<ul class="blog-list">
		{
			allAuthors.map((author) => (
				<li>
					<a href={translatePath(`/author/${author.slug}`)} class="group block py-8">
						<p class="font-mono text-lg font-medium uppercase tracking-wide text-slate-100 transition-colors group-hover:text-white lg:text-xl">
							{author.data.name}
						</p>
						<p class="mt-2 max-w-3xl text-base text-slate-400">{author.data.description}</p>
					</a>
				</li>
			))
		}
	</ul>
</KickerPage>
