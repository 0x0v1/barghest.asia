---
import { type CollectionEntry } from "astro:content";

import EntriesOne from "@/components/blog/Entry.astro";
import KickerPage from "@components/global/KickerPage.astro";
import { getLangFromUrl } from "@i18n/utils";

interface Props {
	tag: string;
	posts: CollectionEntry<"posts">;
}

const { tag, posts } = Astro.props as Props;
const lang = getLangFromUrl(Astro.url);
const label = lang === "cn" ? "研究主题" : lang === "ru" ? "Тема" : "Research topic";
---

<KickerPage label={label} note={tag}>
		<ul class="grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-3">
			{
				posts.map((post) => (
					<EntriesOne
						url={"/research/" + post.slug}
						title={post.data.title}
						description={post.data.description}
						alt={post.data.title}
						pubDate={post.data.pubDate.toString().slice(0, 10)}
						author={post.data.author}
						image={post.data.image.source}
					/>
				))
			}
		</ul>
</KickerPage>
