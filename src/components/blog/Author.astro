---
import KickerPage from "@components/global/KickerPage.astro";
import { getLangFromUrl } from "@i18n/utils";

const { author } = Astro.props;
const { Content } = await author.render();
const lang = getLangFromUrl(Astro.url);
const label = lang === "cn" ? "作者" : lang === "ru" ? "Автор" : "Author";
---

<KickerPage label={label}>
	<div class="max-w-3xl">
		<h1 class="font-mono text-3xl font-semibold leading-tight text-slate-100 md:text-4xl">{author.data.name}</h1>
		<div class="blog-post-prose prose-styles mt-10">
			<Content />
		</div>
	</div>
</KickerPage>
