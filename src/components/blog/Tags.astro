---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import Title from "@components/global/Title.astro";
import { getLangFromUrl, useTranslatedPath } from "@i18n/utils";

const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);
const subtitle =
	lang === "cn"
		? "浏览 BARGHEST 关于移动安全、间谍软件和数字取证的研究主题。"
		: lang === "ru"
			? "Темы исследований BARGHEST о мобильной безопасности и цифровой криминалистике."
			: "Browse topics covered in BARGHEST security research.";
const title = lang === "cn" ? "研究主题" : lang === "ru" ? "Темы исследований" : "Research topics";
const contentLang = "en";

const allPosts = (await getCollection("posts"))
	.filter((post) => {
		const [postLang, ...slug] = post.slug.split("/");
		return postLang === contentLang;
	})
	.map((post) => {
		const [postLang, slug] = post.slug.split("/");

		return {
			...post,
			slug: slug,
		};
	})
	.sort((a, b) => Number(b.data.pubDate) - Number(a.data.pubDate));

const tags = [...new Set(allPosts.map((post) => post.data.tags).flat())];
---

<section>
	<div class="mx-auto px-8 py-24 md:px-12 lg:pt-32 2xl:max-w-7xl">
		<div>
			<Title class="pb-10 pt-20 uppercase" title={title} subtitle={subtitle} />
		</div>
		<div>
			<ol class="mt-12 flex flex-col divide-y divide-zinc-800 py-8">
				{
					tags.map((tag) => (
						<li class="w-full py-8 font-mono text-xl font-semibold text-zinc-800 hover:text-black md:text-2xl ">
							<a href={translatePath(`/tags/${tag}`)} class="flex w-full items-center justify-between">
								{tag}{" "}
								<span class="ml-auto">
									<Icon name="ic:baseline-arrow-right" width="30" />
								</span>
							</a>
						</li>
					))
				}
			</ol>
		</div>
	</div>
</section>
