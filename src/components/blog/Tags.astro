---
import { getCollection } from "astro:content";
import KickerPage from "@components/global/KickerPage.astro";
import { getLangFromUrl, useTranslatedPath } from "@i18n/utils";

const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);
const subtitle =
	lang === "cn"
		? "浏览 BARGHEST 关于移动安全、间谍软件和数字取证的研究主题。"
		: lang === "ru"
			? "Темы исследований BARGHEST о мобильной безопасности и цифровой криминалистике."
			: "Browse topics covered in BARGHEST security research.";
const title = lang === "cn" ? "研究主题" : lang === "ru" ? "Темы исследований" : "Research topics";
const contentLang = "en";

const allPosts = (await getCollection("posts"))
	.filter((post) => {
		const [postLang, ...slug] = post.slug.split("/");
		return postLang === contentLang;
	})
	.map((post) => {
		const [postLang, slug] = post.slug.split("/");

		return {
			...post,
			slug: slug,
		};
	})
	.sort((a, b) => Number(b.data.pubDate) - Number(a.data.pubDate));

const tags = [...new Set(allPosts.map((post) => post.data.tags).flat())];
const countFor = (tag: string) => allPosts.filter((post) => post.data.tags.includes(tag)).length;
---

<KickerPage label={title} note={subtitle}>
	<ul class="blog-list">
		{
			tags.map((tag) => (
				<li>
					<a href={translatePath(`/tags/${tag}`)} class="group flex items-baseline gap-6 py-4">
						<span class="font-mono text-lg font-medium uppercase tracking-wide text-slate-100 transition-colors group-hover:text-white lg:text-xl">
							{tag}
						</span>
						<span class="font-mono text-xs text-slate-500">{countFor(tag)}</span>
					</a>
				</li>
			))
		}
	</ul>
</KickerPage>
