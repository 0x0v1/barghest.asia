---
import { getLangFromUrl, useTranslations } from "@i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="blog-index">
	<div class="mx-auto flex flex-col gap-16 px-8 py-24 md:px-12 lg:pt-32 2xl:max-w-7xl">
		<div class="blog-kicker pt-20">
			<p class="font-mono text-xs font-semibold uppercase text-slate-400">{t("contact.title")}</p>
		</div>
		<div>
			<a
				href="mailto:info@barghest.asia"
				class="inline-block break-all text-2xl font-semibold text-white underline decoration-1 underline-offset-[0.3em] transition hover:decoration-2 lg:text-4xl">
				info@barghest.asia
			</a>
			<p class="mt-6 max-w-2xl text-lg leading-8 text-slate-400">{t("contact.subtitle")}</p>
		</div>
		<div class="max-w-4xl">
			<div class="flex flex-wrap items-baseline justify-between gap-4">
				<h2 class="text-2xl font-semibold text-white lg:text-3xl">PGP public key</h2>
				<button type="button" id="copy-pgp" class="text-link">Copy key</button>
			</div>
			<p class="mt-5 text-lg leading-8 text-slate-400">Encrypt anything sensitive to this key before sending.</p>
			<pre id="pgp-key" class="mt-8 overflow-x-auto whitespace-pre-wrap break-all rounded-lg bg-zinc-950 p-6 font-mono text-xs leading-6 text-slate-300">-----BEGIN PGP PUBLIC KEY BLOCK-----

xjMEaR7oFBYJKwYBBAHaRw8BAQdA7KWt5mzZqLpFODfrbW4d+GMJwlBZN4BC
097N9IlGq87NJ2luZm9AYmFyZ2hlc3QuYXNpYSA8aW5mb0BiYXJnaGVzdC5h
