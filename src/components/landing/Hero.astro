---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { getLangFromUrl, useTranslations, useTranslatedPath } from "@i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const latest = (await getCollection("posts"))
	.filter((post) => post.slug.split("/")[0] === "en")
	.sort((a, b) => Number(b.data.pubDate) - Number(a.data.pubDate))[0];
const latestSlug = latest?.slug.split("/").slice(1).join("/");
---

<section id="hero" class="section hero !pb-20 !pt-36 lg:!pb-32 lg:!pt-48">
	<div class="col-span-12 mx-auto grid w-full max-w-7xl items-center gap-14 lg:grid-cols-12 lg:gap-16">
		<div class="lg:col-span-7">
			<h1 class="font-display text-5xl uppercase leading-[0.95] text-white sm:text-6xl xl:text-7xl">
				{t("hero.title.main")} {t("hero.title.1")}
			</h1>
			<p class="mt-10 max-w-xl text-lg leading-8 text-slate-300 lg:text-xl lg:leading-9">{t("hero.subtitle")}</p>
			<div class="mt-12 flex flex-wrap items-center gap-6">
				<a href={translatePath("/research/")} class="btn btn-solid">{t("blog.title")}</a>
				<a href={translatePath("/contact/")} class="text-link">{t("contact")}</a>
			</div>
		</div>
		{
			latest && (
				<a href={translatePath("/research/" + latestSlug)} class="hero-feature group block lg:col-span-5">
					<div class="overflow-hidden rounded-lg">
						<Image
							src={latest.data.image.source}
							alt={latest.data.image.alt}
							widths={[480, 768, 1100]}
							sizes="(min-width: 1024px) 40vw, 100vw"
							class="aspect-[4/5] w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
						/>
					</div>
					<p class="mt-5 text-sm text-slate-500">Latest research</p>
					<p class="mt-1 text-lg font-medium leading-7 text-slate-100 group-hover:text-white">{latest.data.title}</p>
				</a>
			)
		}
	</div>
</section>
