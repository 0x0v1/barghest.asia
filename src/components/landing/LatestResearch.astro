---
import { getCollection } from "astro:content";
import Entry from "@/components/blog/Entry.astro";
import { getLangFromUrl, useTranslations, useTranslatedPath } from "@i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const posts = (await getCollection("posts"))
	.filter((post) => post.slug.split("/")[0] === "en")
	.map((post) => ({ ...post, slug: post.slug.split("/").slice(1).join("/") }))
	.sort((a, b) => Number(b.data.pubDate) - Number(a.data.pubDate))
	.slice(1, 4);
---

<section id="research" class="section !py-24 lg:!py-36">
	<div class="col-span-12 mx-auto w-full max-w-7xl">
		<div class="flex flex-wrap items-end justify-between gap-6">
			<h2 class="section-title">{t("blog.title")}</h2>
			<a href={translatePath("/research/")} class="text-link">All research</a>
		</div>
		<div class="mt-16 grid grid-cols-1 gap-12 md:grid-cols-2 lg:mt-20 lg:grid-cols-3">
			{
				posts.map((post) => (
					<Entry
						url={"/research/" + post.slug}
						title={post.data.title}
						description={post.data.description}
						pubDate={post.data.pubDate.toString().slice(0, 10)}
						author={post.data.author}
						image={post.data.image.source}
					/>
				))
			}
		</div>
	</div>
</section>
