---
import { getLangFromUrl, useTranslatedPath } from "@i18n/utils";

const { class: className } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);

const paragraphs = [
	"Our mission is to protect the people most often targeted by surveillance: journalists, activists, and human rights defenders. Repressive regimes and the mercenary spyware industry invest heavily in compromising the mobile devices these people carry every day, and the methods they use are rarely visible until the harm is already done.",
	"We are a non-profit of hackers, public interest technologists, and software developers. We study iOS and Android internals to understand the flaws that spyware vendors rely on. That understanding guides our forensic work, where we examine real phones for signs of infection, and it shapes the software we build and release openly, so others can detect and analyze the same threats.",
	"Who gets this kind of help still depends on the wrong things: who you know, how high-profile your case is, and whether you can pay for a service you trust with your data. The people at greatest risk are too often the last to get answers. We want strong forensic analysis to reach everyone who needs it, not only those with the right contacts or budget.",
];
---

<section id="operating-standards" class:list={["section !py-24 lg:!py-36", className]}>
	<div class="col-span-12 mx-auto w-full max-w-7xl">
		<h2 class="section-title">How we work</h2>
		<div class="mt-16 max-w-5xl space-y-8 lg:mt-20">
			{paragraphs.map((text) => <p class="text-lg leading-8 text-slate-400">{text}</p>)}
		</div>
		<div class="mt-12">
			<a href={translatePath("/about/")} class="btn btn-solid">About us</a>
		</div>
	</div>
</section>
