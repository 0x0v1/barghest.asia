---
import { getLangFromUrl, useTranslatedPath } from "@i18n/utils";

const { class: className } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);

const workAreas = [
	{
		title: "Democratizing threat research",
		content:
			"Civil society needs to be able to investigate digital threats for itself. Yet forensic and threat research capabilities remain concentrated in private companies, governments, and specialist labs. We publish tools and methods that people can inspect, run locally, and adapt without sending sensitive evidence to a central provider.",
	},
	{
		title: "Offensive security research",
		content:
			"We hack software to understand how it fails. Our work includes penetration testing, vulnerability analysis, reverse engineering, and exploitation research, with responsible disclosure when we find security flaws.",
	},
	{
		title: "Research-led development",
		content:
			"Our security research feeds directly into our software. Our in-house engineers turn what we learn about attacks and spyware into open-source forensic tools. Development is never outsourced or subgranted.",
	},
];
---

<section id="operating-standards" class:list={["section home-dark-section bg-zinc-900 py-24 text-white lg:py-32", className]}>
	<div class="col-span-12 mx-auto w-full max-w-7xl">
		<div class="max-w-5xl">
			<h2 class="max-w-4xl text-3xl font-semibold leading-tight tracking-normal text-white sm:text-4xl lg:text-5xl">
				We uncover software vulnerabilities, study how they’re exploited, and use that research to build open-source forensic tools for civil society.
			</h2>
			<p class="mt-8 max-w-3xl text-base leading-8 text-zinc-300 md:text-lg">
				BARGHEST is a security research and development team. Our offensive security research informs the open-source forensic tools we build
				in-house. We put these tools in communities’ hands so they can investigate spyware without relying on large technology companies, closed
				services, or distant specialist labs.
			</p>
			<div class="mt-10 flex flex-wrap gap-3">
				<a
					href={translatePath("/blog/")}
					class="inline-flex h-10 items-center justify-center rounded bg-white px-4 text-sm font-semibold text-zinc-950 transition hover:bg-zinc-200">
					Read research
				</a>
				<a
					href={translatePath("/escalation/")}
					class="inline-flex h-10 items-center justify-center rounded border border-zinc-600 px-4 text-sm font-semibold text-white transition hover:border-zinc-300 hover:bg-zinc-800">
					Escalate a case
				</a>
			</div>
		</div>

		<ol class="mt-20 grid gap-10 lg:grid-cols-3 lg:gap-12">
			{
				workAreas.map(({ title, content }) => (
					<li>
						<div class="max-w-md">
							<h3 class="text-2xl font-semibold leading-tight tracking-normal text-white">{title}</h3>
							<p class="mt-5 text-base leading-8 text-zinc-400">{content}</p>
						</div>
					</li>
				))
			}
		</ol>
	</div>
</section>
