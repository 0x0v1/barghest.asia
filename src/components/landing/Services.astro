---
const services = [
	{
		title: "Mobile forensics",
		content: "Android and iOS evidence collection, device triage and spyware investigation for people and organisations at risk.",
	},
	{
		title: "Vulnerability research",
		content: "Reverse engineering, exploitation research and coordinated disclosure of flaws in the software civil society relies on.",
	},
	{
		title: "Open tooling",
		content: "Self-hostable tools we build in-house and publish in the open. Evidence stays with the communities that collect it.",
	},
	{
		title: "Security research",
		content: "Studying the spyware, malware and attack techniques used against civil society, and publishing what we find.",
	},
];
---

<section id="services" class="section !py-24 lg:!py-36">
	<div class="col-span-12 mx-auto w-full max-w-7xl">
		<h2 class="section-title">What we do</h2>
		<div class="mt-16 grid gap-x-16 gap-y-14 md:grid-cols-2 lg:mt-20">
			{
				services.map(({ title, content }) => (
					<div class="service block">
						<h3 class="text-2xl font-semibold text-white lg:text-3xl">{title}</h3>
						<p class="mt-4 max-w-lg text-lg leading-8 text-slate-400">{content}</p>
					</div>
				))
			}
		</div>
	</div>
</section>
