---
import { Image } from "astro:assets";
import wolfMark from "@assets/images/global/wolf-mark.png";

const defaults = { font: "'Inter Tight'", weight: 600, stretch: "100%", tracking: "0.14em", size: 1.3 };
const { font = defaults.font, weight = defaults.weight, stretch = defaults.stretch, tracking = defaults.tracking, size = defaults.size, class: className } =
	Astro.props;
const style = `--logo-font: ${font}; --logo-weight: ${weight}; --logo-stretch: ${stretch}; --logo-tracking: ${tracking}; --logo-size: ${size}rem`;
---

<span class:list={["wordmark", className]} style={style}>
	<Image src={wolfMark} alt="" class="logo-svg wordmark-mark" widths={[96, 192]} sizes="48px" />
	<span class="wordmark-text">
		<span class="wordmark-name">BARGHEST</span>
		<span class="wordmark-sub">Research Group</span>
	</span>
</span>

<style>
	.wordmark {
		display: inline-flex;
		align-items: center;
		gap: 0.85rem;
		color: #040404;
	}
	:global(body.site-dark) .wordmark {
		color: #fff;
	}
	.wordmark-mark {
		height: 2.9rem;
		width: auto;
	}
	.wordmark-text {
		display: flex;
		flex-direction: column;
		line-height: 1;
	}
	.wordmark-name {
		font-family: var(--logo-font), sans-serif;
		font-size: var(--logo-size);
		font-weight: var(--logo-weight);
		font-stretch: var(--logo-stretch);
		letter-spacing: var(--logo-tracking);
		font-synthesis: none;
	}
	.wordmark-sub {
		margin-top: 0.35rem;
		font-family: "Inter var", "Inter", sans-serif;
		font-size: 0.6rem;
		font-weight: 500;
		letter-spacing: 0.3em;
		text-transform: uppercase;
		opacity: 0.65;
	}
	@media (min-width: 768px) {
		.wordmark-mark {
			height: 3.25rem;
		}
		.wordmark-name {
			font-size: calc(var(--logo-size) * 1.15);
		}
		.wordmark-sub {
			font-size: 0.66rem;
		}
	}
</style>
