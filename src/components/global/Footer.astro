---
import { Image } from "astro:assets";
import { getLangFromUrl, useTranslatedPath, useTranslations } from "@i18n/utils";
import wolfHead from "@assets/images/projects/BARGHEST.png";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<footer class="section !py-12 lg:!py-16">
	<div class="footer-plain col-span-12 grid w-full gap-10 font-mono text-sm leading-7 text-slate-500 lg:grid-cols-12 lg:gap-16">
		<!-- Wolf head on the left, as in the original footer -->
		<a href={translatePath("/")} aria-label="Home" class="footer-wolf block lg:col-span-3">
			<Image src={wolfHead} alt="BARGHEST" widths={[160, 320]} sizes="160px" class="w-32 opacity-90 transition-opacity hover:opacity-100 lg:w-40" />
		</a>
		<div class="space-y-2 lg:col-span-9 lg:col-start-4">
		<p>
			<a href={translatePath("/")}>Home</a> ·
			<a href={translatePath("/about/")}>About</a> ·
			<a href={translatePath("/research/")}>Research</a> ·
			<a href={translatePath("/blog/")}>{t("feed.title")}</a> ·
			<a href={translatePath("/mail/")}>Mailing list</a> ·
			<a href={translatePath("/tags/")}>Tags</a> ·
			<a href={translatePath("/contact/")}>{t("contacts")}</a> ·
			<a href={translatePath("/privacy/")}>Privacy</a> ·
			<a href="/rss.xml">RSS</a>
		</p>
		<p>
			<a href="mailto:info@barghest.asia">info@barghest.asia</a> ·
			<a href="https://infosec.exchange/@barghest" target="_blank">Mastodon</a> ·
			<a href="https://x.com/barghestasia" target="_blank">X</a> ·
			<a href="https://github.com/BARGHEST-ngo" target="_blank">GitHub</a>
		</p>
		<p>CC0 No Rights Reserved</p>
		</div>
	</div>
</footer>

<style>
	.footer-plain a {
		color: #94a3b8;
		text-decoration: underline;
		text-underline-offset: 0.3em;
	}
	.footer-plain a:hover {
		color: #fff;
	}
	.footer-plain .footer-wolf {
		text-decoration: none;
	}
	/* The wolf head is black; flip it to white on dark pages */
	:global(body.site-dark) .footer-wolf img,
	:global(body.blog-dark-page) .footer-wolf img {
		filter: invert(1);
	}
</style>
