---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { getLangFromUrl, getUrlWithoutLang, useTranslations, useTranslatedPath } from "@i18n/utils";
import brandLogo from "@assets/images/global/brand-logo-7.png";

const isDev = import.meta.env.DEV;

const lang = getLangFromUrl(Astro.url);
const path = getUrlWithoutLang(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const localeOptions = [
	{ code: "en", label: "EN" },
	{ code: "cn", label: "CN" },
	{ code: "ru", label: "RU" },
] as const;

let pages = [
	{
		title: t("homepage"),
		url: "/",
	},
	{
		title: t("about"),
		url: "/about/",
	},
	{
		title: t("blog.title"),
		url: "/research/",
	},
	{
		title: t("feed.title"),
		url: "/blog/",
	},
	{
		title: t("news.title"),
		url: "/mail/",
	},
	{
		title: t("contacts"),
		url: "/contact/",
	},
];

// if (isDev) {
// 	pages.push({
// 		title: "Overview",
// 		url: "/system/overview",
// 	});
// }

const { pathname } = Astro.url;
const isEditorialIndexPath = /^(?:\/(?:cn|ru))?\/(?:research|blog|mail|about|contact|tags|author|privacy|research-privacy|mesh\/privacy)(?:\/|$)/.test(pathname);
const localePrefix = /^\/(?:cn|ru)(?=\/|$)/;
---

<header>
	<a
		href={translatePath("/")}
		aria-label="Home"
		data-logo-target="visible"
		class:list={["logo absolute z-50 flex items-start", isEditorialIndexPath && "logo-hidden"]}>
		<span class="brand-logo block h-11 pt-1 md:h-14 lg:h-16">
			<Image src={brandLogo} alt="BARGHEST Research Group" widths={[240, 480, 720]} sizes="186px" loading="eager" />
		</span>
	</a>
	<div data-xdata="{ open: false }" class="navigation absolute right-0 top-0 z-50" data-xbind.class="{'w-full navbar-open': open}">
		<div class="ml-auto md:max-w-fit" data-xbind.class="{'max-w-3xl': open, 'max-w-[8rem]': !open }">
			<div class="mx-auto w-full">
				<div
					class="nav-container relative mx-auto flex w-full flex-col justify-center overflow-x-hidden bg-zinc-950 md:flex-row-reverse md:bg-transparent">
					<div class="flex flex-row items-center justify-end md:hidden">
						<a
							class="px-3 py-[0.4rem] pl-4"
							href={translatePath("/contact/")}
							aria-label="Contact Page"
							data-logo-target="visible">
							<Icon class="text-white" name="octicon:mail-16" width="20" data-xbind.class="{'hidden': open}" />
						</a>
						<button
							data-xon.click="open = !open"
							data-xbind.style="{'padding-top': open ? '1rem' : '0.4rem'}"
							aria-label="Open navbar"
							class="inline-flex items-center justify-center px-3 py-[0.4rem] pr-4 text-white hover:text-blue-300 focus:text-white focus:outline-none">
							<svg class="h-6 w-6" stroke="currentColor" fill="none" viewBox="0 0 24 24">
								<path
									data-xbind.class="{'hidden': open, 'inline-flex': !open }"
									class="inline-flex"
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="2"
									d="M4 6h16M4 12h16M4 18h16">
								</path>
								<path
									data-xbind.class="{'hidden': !open, 'inline-flex': open }"
									class="hidden"
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="2"
									d="M6 18L18 6M6 6l12 12">
								</path>
							</svg>
						</button>
					</div>
					<nav data-xbind.class="{'flex': open, 'hidden': !open}" class="hidden flex-grow flex-col justify-center py-12 md:flex md:py-0">
						<ul
							class="flex list-none flex-col items-end justify-center gap-2 px-2 text-center text-3xl md:flex-row md:items-center md:text-base">
							{
								pages.map((page) => (
									<li data-cursor-hover>
										<a
											href={translatePath(page.url)}
											data-logo-target={["/research/", "/blog/", "/mail/", "/about/", "/contact/"].includes(page.url) ? "hidden" : "visible"}
											class={`inline-block cursor-pointer px-1 py-[0.33rem] ${
												page.url === pathname ||
												page.url === pathname.replace(localePrefix, "") ||
												((["/research/", "/blog/", "/mail/", "/about/", "/contact/"].includes(page.url)) && isEditorialIndexPath && pathname.replace(localePrefix, "").startsWith(page.url))
													? "active"
													: ""
											}`}>
											<span class="menu-item-container inline-block">
												<span class="menu-item px-2 py-1 text-sm font-normal leading-8 text-zinc-400 hover:text-white focus:text-white focus:shadow-none focus:outline-none">
													{page.title}
												</span>
											</span>
										</a>
									</li>
								))
							}
							<li class="flex items-center px-3 py-[0.33rem]" aria-label="Language selector">
								{
									localeOptions.map((locale) => (
										<a
											href={translatePath(path, locale.code)}
											aria-current={lang === locale.code ? "page" : undefined}
											class:list={[
												"px-1 text-sm font-semibold leading-8 transition-colors hover:text-white focus:text-white focus:outline-none",
												lang === locale.code ? "text-white" : "text-zinc-400",
											]}>
											{locale.label}
										</a>
									))
								}
							</li>
						</ul>
					</nav>
				</div>
			</div>
		</div>
	</div>
</header>

<style>
	.logo {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
		transition:
			opacity 420ms ease,
			transform 420ms ease,
			visibility 0ms linear 0ms;
	}
	.logo.logo-hidden {
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
		transform: translateY(-0.5rem);
		transition:
			opacity 360ms ease,
			transform 360ms ease,
			visibility 0ms linear 360ms;
	}
	.logo {
		z-index: 2999;
	}
	.brand-logo {
		color: #040404;
	}
	:global(body.site-dark) .brand-logo {
		color: #fff;
	}
	.brand-logo :global(img) {
		display: block;
		height: 100%;
		width: auto;
	}
	:global(body.site-dark) .brand-logo :global(img) {
		filter: invert(1);
	}
	.logo.logo-no-transition {
		transition: none;
	}
	.navigation,
	.logo {
		padding: 1rem var(--base-padding-x);
	}
	@media (max-width: 539px) {
	}
	@media (min-width: 768px) {
		.navigation,
		.logo {
			padding: 2rem var(--base-padding-x);
		}
	}
	.resizable:before {
		content: "|";
		position: absolute;
		left: 0.4rem;
		top: 0.36rem;
		font-size: 12px;
		line-height: 23px;
		color: #8e8e8e;
		opacity: 0;
		text-shadow: 4px 0 #8e8e8e;
		transition: all 0.5s ease;
	}
	.collapsed .resizable:before {
		opacity: 1;
	}
	/* sourcehut-style: plain text links, current page underlined */
	nav a.active .menu-item {
		color: #fff;
		text-decoration: underline;
		text-underline-offset: 0.35em;
	}
</style>

<script>
	import { gsap } from "gsap";

	function init() {
		const logo = document.querySelector<HTMLElement>("header .logo");
		const isResearchPage = /^(?:\/(?:cn|ru))?\/(?:research|blog|mail|about|contact|tags|author|privacy|research-privacy|mesh\/privacy)(?:\/|$)/.test(window.location.pathname);

		if (logo && isResearchPage) {
			logo.classList.add("logo-hidden");
			sessionStorage.removeItem("barghestLogoFadeIn");
		} else if (logo && sessionStorage.getItem("barghestLogoFadeIn") === "true") {
			sessionStorage.removeItem("barghestLogoFadeIn");
			logo.classList.add("logo-no-transition", "logo-hidden");
			window.requestAnimationFrame(() => {
				logo.classList.remove("logo-no-transition");
				window.requestAnimationFrame(() => {
					logo.classList.remove("logo-hidden");
				});
			});
		} else if (logo) {
			logo.classList.remove("logo-hidden", "logo-no-transition");
		}

		document.querySelectorAll<HTMLAnchorElement>("a[data-logo-target]").forEach((link) => {
			function handleLogoTransition(event: MouseEvent) {
				if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
					return;
				}

				const target = link.dataset.logoTarget;
				const href = link.href;
				const currentUrl = window.location.href.replace(/#.*$/, "");
				const nextUrl = href.replace(/#.*$/, "");

				if (!target || currentUrl === nextUrl) {
					return;
				}

				event.preventDefault();

				if (target === "hidden") {
					sessionStorage.removeItem("barghestFooterLogoFadeIn");
					logo?.classList.add("logo-hidden");
					window.setTimeout(() => {
						window.location.href = href;
					}, 260);
					return;
				}

				sessionStorage.setItem("barghestLogoFadeIn", "true");
				sessionStorage.setItem("barghestFooterLogoFadeIn", "true");
				window.location.href = href;
			}

			link.removeEventListener("click", handleLogoTransition);
			link.addEventListener("click", handleLogoTransition);
		});

		// sourcehut-style: no shrink-on-scroll animation
		return;

		let isHoveringMenu = false;
		let menuCollapsed = false;

		const pageLinksUl = document.querySelector("header .nav-container nav ul");

		if (!pageLinksUl) {
			return;
		}

		let menuCollapseTl = gsap
			.timeline({
				defaults: {
					ease: "back.inOut(1.7)",
					duration: 0.4,
				},
				paused: true,
				onStart: () => {
					pageLinksUl.classList.add("collapsed");
				},
			})
			.to("header .nav-container", { width: 125 })
			.to(
				pageLinksUl,
				{
					x: () => {
						const pathName = window.location.pathname;

						if (pathName === "/" || pathName === "/cn/" || pathName === "/ru/") {
							return "9.5rem";
						} else if (/^(?:\/(?:cn|ru))?\/(?:research|blog|mail|about|contact|tags|author|privacy|research-privacy|mesh\/privacy)(?:\/|$)/.test(pathName)) {
							return "3.5rem";
						}

						return "-3.5rem";
					},
				},
				"<",
			);

		const isTouchDevice = window.matchMedia("(hover: none)").matches;

		if (window.innerWidth >= 768 && !isTouchDevice) {
			function expandMenu() {
				menuCollapseTl.reverse();
				pageLinksUl?.classList.remove("collapsed");
				document.querySelector("header .navigation")?.classList.remove("collapsed");
				menuCollapsed = false;
			}

			function collapseMenu() {
				if (window.scrollY > 200) {
					menuCollapseTl.play();
					pageLinksUl?.classList.add("collapsed");
					document.querySelector("header .navigation")?.classList.add("collapsed");
					menuCollapsed = true;
				}
			}

			collapseMenu();

			const navContainer = document.querySelector(".nav-container") as HTMLElement;

			function mouseEnterHandler() {
				isHoveringMenu = true;
				expandMenu();
			}

			function mouseLeaveHandler() {
				isHoveringMenu = false;
				collapseMenu();
			}

			function handleScroll() {
				if (window.scrollY > 200 && !isHoveringMenu && !menuCollapsed) {
					collapseMenu();
				} else if (window.scrollY <= 200 && menuCollapsed) {
					expandMenu();
				}
			}

			navContainer?.removeEventListener("mouseenter", mouseEnterHandler);
			navContainer?.addEventListener("mouseenter", mouseEnterHandler);

			navContainer?.removeEventListener("mouseleave", mouseLeaveHandler);
			navContainer?.addEventListener("mouseleave", mouseLeaveHandler);

			window?.removeEventListener("scroll", handleScroll);
			window?.addEventListener("scroll", handleScroll);
		}
	}

	document.removeEventListener("DOMContentLoaded", init); // astro:page-load
	document.addEventListener("DOMContentLoaded", init); // astro:page-load
</script>
