---
// Shared layout for index and info pages: small mono label instead of a large heading.
const { label, note } = Astro.props;
---

<section class="blog-index">
	<div class="mx-auto flex flex-col gap-16 px-8 py-24 md:px-12 lg:pt-32 2xl:max-w-7xl">
		<div class="blog-kicker pt-20">
			<p class="font-mono text-xs font-semibold uppercase text-slate-400">{label}</p>
			{note && <p class="font-mono text-xs text-slate-500">{note}</p>}
		</div>
		<slot />
	</div>
</section>
