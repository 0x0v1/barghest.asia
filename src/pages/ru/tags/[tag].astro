---
import { getCollection } from "astro:content";
import type { AstroSeoProps } from "@astrolib/seo";
import Tag from "@components/blog/Tag.astro";
import BaseLayout from "@layouts/BaseLayout.astro";

export async function getStaticPaths() {
	const allPosts = (await getCollection("posts")).filter((post) => {
		const [postLang] = post.slug.split("/");
		return postLang === "en";
	});

	const uniqueTags = [...new Set(allPosts.flatMap((post) => post.data.tags))];
	return uniqueTags.map((tag) => ({
		params: { tag },
		props: {
			posts: allPosts
				.filter((post) => post.data.tags.includes(tag))
				.map((post) => ({ ...post, slug: post.slug.split("/").slice(1).join("/") })),
		},
	}));
}

const { tag } = Astro.params;
const { posts } = Astro.props;

const seo: AstroSeoProps = {
	title: `${tag} — исследования | BARGHEST`,
	description: `Исследования и технический анализ BARGHEST по теме ${tag}.`,
};
---

<BaseLayout seo={seo}>
	<Tag tag={tag} posts={posts} />
</BaseLayout>
