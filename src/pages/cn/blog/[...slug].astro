---
import { getCollection } from "astro:content";
import NewsPost from "@components/news/NewsPost.astro";
import BaseLayout from "@layouts/BaseLayout.astro";

export async function getStaticPaths() {
	return (await getCollection("news"))
		.filter((post) => post.slug.split("/")[0] === "en")
		.map((post) => ({ params: { slug: post.slug.split("/").slice(1).join("/") }, props: { post } }));
}

const { post } = Astro.props;
---

<BaseLayout seo={{ title: `${post.data.title} | BARGHEST`, description: post.data.description }} bodyClass="blog-dark-page">
	<NewsPost post={post} />
</BaseLayout>
