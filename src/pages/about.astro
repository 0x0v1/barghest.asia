---
import AboutPage from "@/components/infopages/About.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { AstroSeoProps } from "@astrolib/seo";

const seo: AstroSeoProps = {
	title: "About BARGHEST - Open-Source Security Research",
	description: "BARGHEST investigates mobile surveillance and builds open-source forensic tools for civil society in East and South Asia.",
	canonical: "https://barghest.asia/about/",
};
---

<BaseLayout seo={seo} bodyClass="blog-dark-page">
	<AboutPage />
</BaseLayout>
