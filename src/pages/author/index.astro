---
import { getCollection } from "astro:content";
import type { AstroSeoProps } from "@astrolib/seo";
import Authors from "@components/blog/Authors.astro";
import BaseLayout from "@layouts/BaseLayout.astro";

const allAuthors = await getCollection("authors");

const seo: AstroSeoProps = {
	title: "Authors | BARGHEST",
	description: "People behind BARGHEST security research and open-source forensic tools.",
};
---

<BaseLayout seo={seo} bodyClass="blog-dark-page">
	<Authors />
</BaseLayout>
