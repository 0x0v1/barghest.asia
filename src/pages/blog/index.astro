---
import type { AstroSeoProps } from "@astrolib/seo";
import NewsFeed from "@components/news/NewsFeed.astro";
import BaseLayout from "@layouts/BaseLayout.astro";

const seo: AstroSeoProps = {
	title: "Blog | BARGHEST",
	description: "Blog posts and updates from BARGHEST.",
};
---

<BaseLayout seo={seo} bodyClass="blog-dark-page">
	<NewsFeed />
</BaseLayout>
